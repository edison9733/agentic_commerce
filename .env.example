# Names only. Real values never go in the repository: set them in your shell,
# in Railway Variables, or in the Vercel project settings.

# Agents server, API and MCP (Railway or local)
TESSERA_KEYS=            # output of `npm run keys:export`; paste only into Railway
TESSERA_RELAY_SECRET=    # shared secret between the MCP server and the API
SOLANA_RPC_URL=          # devnet RPC; defaults to a public endpoint
CDP_API_KEY_ID=          # optional: Coinbase CDP facilitator
CDP_API_KEY_SECRET=      # optional: Coinbase CDP facilitator

# Website build (public: compiled into the site, so never put a key here)
VITE_RPC_URLS=
VITE_AGENTS_URL=
