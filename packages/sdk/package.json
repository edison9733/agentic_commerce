{
  "name": "@tessera/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the Tessera program: generated instructions and decoders, PDA helpers, payment verification, and the score formula.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./score": "./src/score.ts"
  },
  "scripts": {
    "codegen": "tsx codama.ts"
  },
  "dependencies": {
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.3.0",
    "@solana/program-client-core": "^8.3.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.5.0",
    "codama": "^1.11.0",
    "typescript": "^5.7.2"
  }
}
